# ShopKart storefront (Nuxt 4)
# Copy to .env for local development. On Vercel, set this in
# Project Settings -> Environment Variables (Production + Preview), then redeploy.

# Public URL of the Strapi API, no trailing slash
# Production example: https://shopkart-api.onrender.com
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
